# Every variable is optional. The value shown is the built-in default in config/settings.py,
# so running without a .env file gives exactly these settings. Copy to .env to override.

# --- Storage ---
DATA_STORAGE_PATH=./data_storage

# --- Backtest period and account ---
BACKTEST_START_DATE=2010-01-01
BACKTEST_END_DATE=2023-01-01
INITIAL_CAPITAL=1000000
TRANSACTION_COST_BPS=10          # per unit of position change

# --- Seasonality (per commodity) ---
ONLY_TRADE_GROWING_SEASON=true
CORN_TRADE_MONTHS=4,5,6
CORN_VOL_REGIME_THRESHOLD=0.30   # stand aside when 20-day annualised vol is above this

# --- Model ---
MODEL_TYPE=ridge                 # ridge | xgboost
TRAIN_WINDOW_YEARS=3
FORWARD_RETURN_DAYS=10
MAX_FEATURES=15
RIDGE_ALPHA=1.0
USE_PCA=true
PCA_N_COMPONENTS=0.95            # integer = fixed count, float in (0,1) = share of variance kept

# --- Signal -> position ---
STRATEGY_MODE=directional        # directional | magnitude
MIN_SIGNAL_STRENGTH=0.01
FIXED_POSITION_SIZE=0.5          # fraction of portfolio per position (directional mode)
TARGET_PORTFOLIO_VOL=0.99        # magnitude mode only
MAX_SINGLE_POSITION=1.0
SIGNAL_CAP=3.0
STOP_LOSS_PCT=0.05
VETO_CONFIDENCE=0.65

# --- Execution realism ---
FEATURE_LAG_DAYS=2               # NASA POWER publishes 1-2+ days late
EXECUTE_NEXT_BAR=true            # trade a decision at the next close

LOG_LEVEL=INFO
